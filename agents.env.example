# Copy to agents.env (scripts/make-agents-env.sh fills it from the Switch .env).
SWITCH_URL=http://switch:8000
AGENT_REGISTRATION_TOKEN=
GATEWAY_ADMIN_EMAIL=admin@switch.local
GATEWAY_ADMIN_PASSWORD=
MATTERMOST_URL=http://mattermost:8065
MATTERMOST_ADMIN_USER=admin
MATTERMOST_ADMIN_PASSWORD=
MATTERMOST_TEAM_NAME=switch
MATTERMOST_USER=user
MATTERMOST_USER_PASSWORD=
# Any OpenAI-compatible endpoint. Default: Zhipu GLM.
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# Also tested with DeepSeek: LLM_BASE_URL=https://api.deepseek.com and its model name.
LLM_MODEL=glm-4.6
LLM_API_KEY=
# Who may approve changes to docs, by the `owner:` in each doc's front matter.
APPROVERS=finance:finance-lead;support:support-lead;it:user;people:user
KB_STALE_DAYS=365
